# ==============================================================================
# FormForge AI & ALV Form Online — Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Mandatory / Core Local Defaults (zero external credentials required)
# ------------------------------------------------------------------------------
PORT=3000
APP_URL=http://localhost:3000
STORAGE_PROVIDER=local
FORMFORGE_WORKER_CONCURRENCY=2

# ------------------------------------------------------------------------------
# 2. Optional Local Runtime & Storage Overrides
# ------------------------------------------------------------------------------
# Override Python executable (defaults to 'python' on Windows, 'python3' on Linux/macOS)
PYTHON_EXECUTABLE=
PYTHON_TIMEOUT_MS=60000

# Local filesystem directories (used when STORAGE_PROVIDER=local)
GENERATED_PDF_DIR=
SIGNED_PDF_DIR=
UPLOADED_ZIPS_DIR=
FORMFORGE_STORAGE_DIR=
FORMFORGE_DB_PATH=

# Upload caps, POPIA retention window, and sliding-window IP rate limiting
MAX_UPLOAD_BYTES=10485760
PDF_RETENTION_HOURS=24
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30

# ------------------------------------------------------------------------------
# 3. Production Credentials & External Integrations (Optional)
# ------------------------------------------------------------------------------
# Optional admin passcode override (leave blank to use first-run Admin Claim UI)
FORMFORGE_ADMIN_PASSWORD=

# PostgreSQL / Redis (used by docker-compose.yml production stack)
DATABASE_URL=
POSTGRES_PASSWORD=
REDIS_URL=

# S3-compatible object storage (required only when STORAGE_PROVIDER=s3)
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=