# GEMINI_API_KEY: Required if Gemini AI features are enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# Application Environment
NODE_ENV="development"
PORT=3000

# Python Executable Override
# Leave blank to auto-detect: "python" on Windows, "python3" on Linux/macOS.
PYTHON_EXECUTABLE=""
PYTHON_TIMEOUT_MS=15000

# Storage Configuration ("local" for development, "s3" for S3-compatible object storage)
STORAGE_PROVIDER="local"
GENERATED_PDF_DIR="public/generated"
SIGNED_PDF_DIR="public/signed"
UPLOADED_ZIPS_DIR="uploaded-zips"

# S3-Compatible Object Storage (used when STORAGE_PROVIDER="s3")
S3_ENDPOINT=""
S3_REGION="af-south-1"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="false"

# Upload & Retention Policies
MAX_UPLOAD_BYTES=10485760
PDF_RETENTION_HOURS=24
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30

# FormForge AI Studio Runtime Configuration
# Leave FORMFORGE_ADMIN_PASSWORD blank to enable first-run administrator claim in the UI.
FORMFORGE_ADMIN_PASSWORD=""
FORMFORGE_STORAGE_DIR="storage/formforge"
FORMFORGE_DB_PATH="storage/formforge/formforge.db"

# Optional External PostgreSQL / Redis (used with docker-compose.yml)
DATABASE_URL=""
REDIS_URL=""
POSTGRES_PASSWORD=""

